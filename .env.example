# CashPilot - Neon Database (Postgres serverless)
# Copiez ces variables dans Vercel (Project Settings → Environment Variables)
# et dans votre .env local

# Connexion poolée (pour l'app runtime)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require

# Connexion directe (pour les migrations Prisma)
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
