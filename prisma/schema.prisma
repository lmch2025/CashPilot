// CashPilot - Prisma schema
// Application de revenus passifs via arbitrage P2P
// Deux modes: "managed" (CashPilot gère) | "alerts" (CashPilot alerte, abonnement)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  pinHash      String
  name         String?
  level        String   @default("starter") // "starter" | "croissance"
  balance      Int      @default(0) // solde actuel en XAF (gains + capital disponible)
  capital      Int      @default(0) // capital total déposé
  totalGains   Int      @default(0) // cumul de tous les gains
  totalExchanges Int    @default(0) // nombre d'échanges réalisés
  status       String   @default("active") // "active" | "paused"
  // Nouveau: mode de fonctionnement
  mode         String   @default("managed") // "managed" (CashPilot gère) | "alerts" (abonnement opportunités)
  // Nouveau: abonnement (pour le mode alerts)
  subscriptionPlan     String?  // "decouverte" | "standard" | "premium"
  subscriptionExpiresAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions     Transaction[]
  robotEvents      RobotEvent[]
  opportunities    Opportunity[]
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  type          String   // "deposit" | "withdraw" | "gain" | "subscription"
  amount        Int      // montant en XAF (positif pour depot/gain/subscription, negatif pour retrait)
  balanceAfter  Int
  description   String
  operator      String?  // "mtn" | "orange" pour depot/retrait/subscription
  // Nouveau: référence au plan d'abonnement (pour type=subscription)
  planId        String?  // "decouverte" | "standard" | "premium"
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, type])
}

model RobotEvent {
  id          String   @id @default(cuid())
  userId      String
  gain        Int      // gain réalisé en XAF
  market      String   // "Binance P2P" | "Yellow Card" | "Paxful" | "Bitget"
  pair        String   // paire échangée (ex: "USDT/XAF")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Nouveau: Opportunités d'achat-vente (pour le mode alerts)
model Opportunity {
  id          String   @id @default(cuid())
  userId      String   // utilisateur destinataire (chaque utilisateur a ses propres opportunités)
  market      String   // "Binance P2P" | "Yellow Card" | "Paxful" | "Bitget"
  pair        String   // "USDT/XAF" | "BTC/XAF"
  buyPrice    Int      // prix d'achat en XAF (par unité)
  sellPrice   Int      // prix de vente en XAF (par unité)
  estimatedGain Int    // gain estimé en XAF (pour 50 000 XAF de capital de référence)
  estimatedGainPercent Float // pourcentage du gain
  validUntil  DateTime // date d'expiration de l'opportunité
  status      String   @default("active") // "active" | "expired" | "executed" | "skipped"
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([validUntil])
}

// Configuration clé-valeur (pour l'admin)
model Config {
  key       String   @id
  value     String   // JSON string
  updatedAt DateTime @updatedAt
}

// === Système d'automatisation des opportunités ===

// Prix de marché en temps réel (fetch depuis APIs Binance, Bybit, etc.)
model MarketData {
  id          String   @id @default(cuid())
  platform    String   // "binance" | "bybit" | "yellowcard" | "noones" | "polymarket" | etc.
  pair        String   // "USDT/XAF" | "BTC/USDT" | "ETH/USDT" | etc.
  price       Float    // prix actuel
  bid         Float?   // meilleur prix d'achat
  ask         Float?   // meilleur prix de vente
  volume24h   Float?   // volume 24h
  rawData     String?  // JSON complet de la réponse API (pour debug)
  fetchedAt   DateTime @default(now())

  @@index([platform, pair])
  @@index([fetchedAt])
}

// Opportunités détectées par le scanner (avant approbation admin)
model DetectedOpportunity {
  id              String   @id @default(cuid())
  // Identification
  type            String   // "p2p_arbitrage" | "inter_platform" | "triangular" | "funding_rate" | "staking" | "prediction" | "manual"
  automationLevel String   @default("semi_auto") // "full_auto" | "semi_auto" | "manual"
  // Détails du trade
  buyPlatform     String   // plateforme d'achat
  sellPlatform    String   // plateforme de vente
  pair            String   // paire tradée
  buyPrice        Float    // prix d'achat
  sellPrice       Float    // prix de vente
  spreadPercent   Float    // spread en %
  estimatedGain   Float    // gain estimé en XAF (pour capital de référence)
  estimatedGainPercent Float // gain en %
  capitalRequired Float    // capital minimum requis
  // État
  approvalStatus  String   @default("pending") // "pending" | "approved" | "rejected" | "expired"
  dryRun          Boolean  @default(true) // true = simulation, false = exécution réelle
  validUntil      DateTime // date d'expiration
  // Métadonnées
  riskLevel       String   @default("low") // "low" | "medium" | "high"
  description     String   // description humaine
  rawData         String?  // JSON complet (pour debug)
  // Dates
  detectedAt      DateTime @default(now())
  approvedAt      DateTime?
  approvedBy      String?  // admin userId (pour audit)
  expiresAt       DateTime?

  @@index([approvalStatus])
  @@index([automationLevel])
  @@index([detectedAt])
  @@index([type])
}

// Log des scans (pour monitoring et cron-job.org)
model ScanLog {
  id              String   @id @default(cuid())
  trigger         String   // "cron" | "manual" | "admin"
  status          String   // "success" | "error" | "partial"
  platformsScanned String  // JSON array of platforms
  opportunitiesFound Int   @default(0)
  opportunitiesApproved Int @default(0)
  duration        Int      @default(0) // en millisecondes
  error           String?  // message d'erreur si status=error
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
